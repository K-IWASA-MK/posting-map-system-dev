{
  "name": "aios-workspace",
  "version": "5.0.0-alpha.0",
  "private": true,
  "workspaces": [
    "sdk",
    "projects/*",
    "shared"
  ],
  "description": "AIOS Platform and Products Workspace",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "build:gas": "python3 tools/build_gas.py",
    "test": "npx ts-node -r tsconfig-paths/register tools/testing/TestRunner.ts",
    "architecture:test": "npx ts-node -r tsconfig-paths/register tools/architecture-check.ts",
    "quality:check": "npm run build && npm run architecture:test && npx ts-node -r tsconfig-paths/register tools/testing/TestRunner.ts"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
