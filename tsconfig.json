{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["apps/posting-map/src/core/*"],
      "@foundation/*": ["apps/posting-map/src/foundation/*"],
      "@domain/*": ["apps/posting-map/src/domain/*"],
      "@infra/*": ["apps/posting-map/src/infrastructure/*"],
      "@application/*": ["apps/posting-map/src/application/*"],
      "@api/*": ["apps/posting-map/src/api/*"],
      "@kernel/*": ["aios/kernel/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["apps/posting-map/src/**/*", "aios/**/*", "shared/**/*"],
  "exclude": ["**/deprecated/**/*", "node_modules", "aios/tests/**/*", "aios/transformation/**/*"]
}
