{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolId": { "type": "string", "const": "aios-consensus-v1" },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compatibleVersions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sessionId": { "type": "string" },
    "targetDecisionId": { "type": "string" },
    "voters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scores": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "consensusVerdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "timestamp": { "type": "string" }
  },
  "required": [
    "protocolId",
    "protocolVersion",
    "compatibleVersions",
    "sessionId",
    "targetDecisionId",
    "voters",
    "scores",
    "consensusVerdict",
    "timestamp"
  ]
}
