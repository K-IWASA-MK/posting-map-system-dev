{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolId": { "type": "string", "const": "aios-ledger-v1" },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compatibleVersions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockIndex": { "type": "number" },
    "timestamp": { "type": "string" },
    "previousHash": { "type": "string" },
    "payload": { "type": "object" },
    "hash": { "type": "string" }
  },
  "required": [
    "protocolId",
    "protocolVersion",
    "compatibleVersions",
    "blockIndex",
    "timestamp",
    "previousHash",
    "payload",
    "hash"
  ]
}
