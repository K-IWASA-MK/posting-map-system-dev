{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolId": { "type": "string", "const": "aios-decision-v1" },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compatibleVersions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decisionId": { "type": "string" },
    "identity": { "type": "string" },
    "capabilityScope": { "type": "string" },
    "context": { "type": "string" },
    "action": { "type": "string" },
    "payload": { "type": "object" },
    "timestamp": { "type": "string" },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signer": { "type": "string" },
          "verdict": { "type": "string", "enum": ["APPROVED", "REJECTED", "WARNING"] },
          "timestamp": { "type": "string" }
        },
        "required": ["signer", "verdict", "timestamp"]
      }
    }
  },
  "required": [
    "protocolId",
    "protocolVersion",
    "compatibleVersions",
    "decisionId",
    "identity",
    "capabilityScope",
    "context",
    "action",
    "payload",
    "timestamp",
    "signatures"
  ]
}
