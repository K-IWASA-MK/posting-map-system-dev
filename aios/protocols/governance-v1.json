{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolId": { "type": "string", "const": "aios-governance-v1" },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compatibleVersions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promiseId": { "type": "string" },
    "visionRef": { "type": "string" },
    "owner": { "type": "string" },
    "executors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "type": "string", "enum": ["DRAFT", "ACCEPTED", "EXECUTING", "FULFILLED", "DRIFT_DETECTED", "REJECTED"] },
    "timestamp": { "type": "string" }
  },
  "required": [
    "protocolId",
    "protocolVersion",
    "compatibleVersions",
    "promiseId",
    "visionRef",
    "owner",
    "executors",
    "reviewers",
    "status",
    "timestamp"
  ]
}
