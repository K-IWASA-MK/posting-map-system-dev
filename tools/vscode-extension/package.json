{
  "name": "cie-platform",
  "displayName": "Code Intelligence Engine",
  "description": "Code Intelligence Engine Platform integration for VS Code.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:cie.build",
    "onCommand:cie.verify",
    "onCommand:cie.doctor",
    "onCommand:cie.report",
    "onCommand:cie.dashboard",
    "onCommand:cie.apiStatus"
  ],
  "main": "./extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "cie.build",
        "title": "CIE: Build"
      },
      {
        "command": "cie.verify",
        "title": "CIE: Verify"
      },
      {
        "command": "cie.doctor",
        "title": "CIE: Doctor"
      },
      {
        "command": "cie.report",
        "title": "CIE: Report"
      },
      {
        "command": "cie.dashboard",
        "title": "CIE: Dashboard"
      },
      {
        "command": "cie.apiStatus",
        "title": "CIE: API Status"
      }
    ]
  }
}
